.{
    .backend = "std.http",
    .declared = .{
        .auth = .{
            .db = .{
                .audience = "db",
                .refresh_before_seconds = 30,
                .token_url = "http://localhost:8888/token",
            },
        },
        .http = .{
            .db = .{
                .base_url = "http://localhost:8888",
                .max_response_bytes = 65536,
                .timeout_ms = 1500,
            },
        },
        .zig = .{
            .data_cruncher = "native/src/helpers/data_cruncher.zig",
        },
    },
    .methods = .{
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
    },
}
