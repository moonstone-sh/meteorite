#!/usr/bin/env sh
set -eu
self="$0"
while [ -L "$self" ]; do
  dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$dir/$link" ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
if [ -f "$root/src/cli/main.lua" ]; then
  meteorite_src="$root/src"
  entry="$root/src/cli/main.lua"
elif [ -f "$root/meteorite/cli/main.lua" ]; then
  meteorite_src="$root/meteorite"
  entry="$root/meteorite/cli/main.lua"
elif [ -f "$root/files/meteorite/cli/main.lua" ]; then
  meteorite_src="$root/files"
  entry="$root/files/meteorite/cli/main.lua"
else
  echo "meteorite: cannot locate cli/main.lua near $root" >&2
  exit 1
fi

if [ "${1:-}" = "dev" ]; then
  METEORITE_DEV_PREPARE_ONLY=1 "${LUA_BIN:-lua}" "$entry" "$@"

  supervisor="$PWD/.meteorite/dev/supervisor.sh"
  if [ ! -f "$supervisor" ]; then
    echo "meteorite: dev supervisor was not created: $supervisor" >&2
    exit 1
  fi

  exec sh "$supervisor"
fi

LUA_PATH="$meteorite_src/?.lua;$meteorite_src/?/init.lua;${LUA_PATH:-;;}" exec "${LUA_BIN:-lua}" "$entry" "$@"
