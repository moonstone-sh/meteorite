worker_processes auto;
error_log stderr error;
daemon off;
pid nginx.pid;

env LUA_PATH;
env LUA_CPATH;

events {
    worker_connections 4096;
}

http {
    access_log off;
    lua_code_cache on;

    keepalive_timeout 65s;
    keepalive_requests 10000;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    init_by_lua_block {
        local path = os.getenv("LUA_PATH")
        if path then package.path = path .. ";" .. package.path end
        local cpath = os.getenv("LUA_CPATH")
        if cpath then package.cpath = cpath .. ";" .. package.cpath end
    }

    init_worker_by_lua_block {
        local app = require("app")
        app.init_db()
        -- LuaJIT warm-up: force-load all modules and pre-compile
        -- etlua templates so the JIT has compiled them before any
        -- benchmark traffic arrives.  The hot request-handler paths
        -- are additionally warmed by the 2s wrk warmup phase.
        require("cjson")
        require("etlua")
        require("luasql.sqlite3")
        -- Trigger JIT compilation of string formatting hot paths
        string.format("warmup:%d:%s", 42, "ok")
        cjson.encode({ok=true, name="warmup", n=1})
    }

    server {
        listen ${{PORT}};

        location / {
            content_by_lua_block {
                require("app").handle()
            }
        }
    }
}
