# syntax=docker/dockerfile:1

FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="Meteorite release"
LABEL org.opencontainers.image.description="Runs a self-contained Meteorite dist/release directory"

WORKDIR /app
RUN groupadd --system meteorite && useradd --system --gid meteorite --home-dir /app --shell /usr/sbin/nologin meteorite

COPY --chown=meteorite:meteorite . /app/

USER meteorite
EXPOSE 8080
ENTRYPOINT ["/app/bin/server"]
